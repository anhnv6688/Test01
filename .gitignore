# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cơ sở dữ liệu cục bộ của bản dựng phát triển
.data/

# Ảnh trang vở của trẻ. Tuyệt đối không đưa vào kho mã: đây là dữ liệu cá nhân
# của trẻ em, và một lần lỡ tay đẩy lên là không gỡ lại được khỏi lịch sử git.
bo-anh-do/
.bo-anh-dien-tap/
*.bao-cao.json

# Tệp nhãn do trang /gan-nhan ghi ra. Nó chép lại nguyên văn bài làm của trẻ,
# nên không vào kho mã dù thư mục ảnh có được đặt ở đâu. Mẫu: docs/nhan-mau.json
nhan.json
nhan.json.*
