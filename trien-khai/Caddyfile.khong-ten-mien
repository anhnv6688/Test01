# Cho máy CHƯA có tên miền — chỉ có địa chỉ IP.
#
# Địa chỉ site phải ghi RÕ IP, không được viết `:443` trống.
#
# Bản đầu viết `:443 { tls internal }`. Nhìn thì hợp lý — nghe mọi tên trên cổng
# 443 — nhưng nó hỏng, và hỏng ở chỗ không nghĩ ra: trình duyệt gọi tới một địa
# chỉ IP thì KHÔNG gửi SNI. Caddy không biết phải xuất chứng chỉ cho tên nào,
# nên không đưa ra chứng chỉ nào cả, và trình duyệt báo ERR_SSL_PROTOCOL_ERROR.
#
# Đó không phải cảnh báo chứng chỉ — cảnh báo thì còn có nút bấm qua. Đây là bắt
# tay TLS đứt hẳn, nghĩa là không ai vào được bằng cách nào.
#
# Ghi rõ IP thì Caddy tự ký một chứng chỉ có IP trong phần tên thay thế, và
# trình duyệt nhận được chứng chỉ để mà kêu — kêu rồi bấm qua được.
#
# Let's Encrypt không cấp chứng chỉ cho địa chỉ IP, nên ở đây bắt buộc là chứng
# chỉ tự ký. CHỈ DÙNG CHO BẢN THỬ. Chứng chỉ tự ký mã hóa được đường truyền
# nhưng không chứng minh được máy bên kia là ai, và quan trọng hơn: nó dạy người
# dùng bấm qua cảnh báo bảo mật — người đã quen bấm qua sẽ bấm qua cả lần thật.
#
# Bản có phụ huynh thật vào phải có tên miền. Dùng trien-khai/Caddyfile.

# Tên mặc định khi khách KHÔNG gửi SNI.
#
# Đây là mảnh cuối của cùng một vấn đề. Ghi rõ IP làm địa chỉ site đã đủ để
# Caddy XIN được chứng chỉ, nhưng chưa đủ để nó ĐƯA RA: Caddy chọn chứng chỉ
# theo SNI, mà khách gọi tới một địa chỉ IP thì không gửi SNI. Không có tên để
# khớp, Caddy trả về TLS alert 80 (internal error) rồi đóng.
#
# Triệu chứng đúng là thứ đã thấy: trình duyệt báo ERR_SSL_PROTOCOL_ERROR, curl
# báo "failed to receive handshake", và cả hai đều KHÔNG phải lỗi chứng chỉ —
# `curl -k` bỏ kiểm chứng chỉ mà vẫn hỏng y hệt. Trong khi nhật ký Caddy thì nói
# đã cấp chứng chỉ xong, nên nhìn hai bên riêng lẻ đều thấy "ổn".
#
# default_sni bảo Caddy: không ai nói tên thì coi như hỏi tên này.
{
	default_sni {$OLY_DIA_CHI_MAY}
}

{$OLY_DIA_CHI_MAY} {
	tls internal
	# Hàng rào mật khẩu của bản thử. Tệp do chay-anh.sh sinh ra: có nội dung ở
	# bản thử, TRỐNG ở bản thật — bản thật có phụ huynh thật vào, không thể đứng
	# sau một mật khẩu dùng chung.
	import /etc/caddy-nguon/bao-ve.caddy

	encode zstd gzip
	reverse_proxy o-ly:3000

	request_body {
		max_size 12MB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}
